# Скопируй в .env.production и заполни. Файл .env.production в git не попадает.

# Convex Cloud: ключ production из настроек проекта и адрес деплоя
CONVEX_DEPLOY_KEY=
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Значения для функций Convex
ANTHROPIC_API_KEY=
BOT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
PUBLIC_APP_URL=https://your-domain.example
DEMO_MODE=live
# 1 разрешает вход без ссылки от родителя: любой посетитель создаёт ребёнка и тратит ключ Claude
DEMO_ALLOW_ANON=

# Только для своего сервера
DOMAIN=your-domain.example
SUPPORT_CONTACT=

# Только для Vercel
VERCEL_TOKEN=
